APP_NAME=WebTopup
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta
ACTIVITY_LOGGER_ENABLED=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
# Use 'db' when running with Docker Compose, or '127.0.0.1' for native execution
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=webtopup
DB_USERNAME=webtopup
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Redis
# Use 'redis' when running with Docker Compose, or '127.0.0.1' for native execution
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Host port — only Nginx is exposed (port 80)
# MySQL and Redis are internal-only, no host port mapping
APP_PORT=80

# Integrasi: atur supplier, cek username, payment gateway, dan credential
# melalui CMS > Settings > Integrasi (/cms/setting/settings).
# Tidak perlu mengisi env integrasi. Contoh berikut hanya fallback opsional;
# hapus tanda # jika diperlukan. Pengaturan CMS selalu diutamakan.
# Default: supplier/username H2H Karuhun, pembayaran QRIS Karuhun.
# SUPPLIER_PROVIDER=h2h
# USERNAME_PROVIDER=h2h
# PAYMENT_GATEWAY=karuhun_qris
# H2H_BASE_URL=https://h2h.karuhundeveloper.com
# H2H_API_KEY=
# H2H_WEBHOOK_SECRET=
# KARUHUN_QRIS_BASE_URL=https://qris.karuhundeveloper.com
# KARUHUN_QRIS_API_KEY=
# KARUHUN_QRIS_PROVIDER=
# PAYWUZ_BASE_URL=https://api.paywuz.id
# PAYWUZ_API_KEY=
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# DIGIFLAZZ_USERNAME=
# DIGIFLAZZ_API_KEY=
# DIGIFLAZZ_WEBHOOK_SECRET=
# APIAGAME_MERCHANT_ID=
# APIAGAME_SECRET_KEY=
